{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/wasp/config.v1.schema.json",
  "title": "WASP configuration v1 (starter contract)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile",
    "target",
    "scope"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "profile": {
      "enum": [
        "passive",
        "active"
      ]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url"
      ],
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "include_hosts"
      ],
      "properties": {
        "include_hosts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "include_subdomains": {
          "type": "boolean"
        },
        "allowed_schemes": {
          "type": "array",
          "items": {
            "enum": [
              "http",
              "https"
            ]
          }
        },
        "allowed_ports": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          }
        },
        "follow_in_scope_redirects": {
          "type": "boolean"
        }
      }
    },
    "modules": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "tls",
          "http",
          "dns",
          "email",
          "domain",
          "network",
          "discovery"
        ]
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "concurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "total_timeout": {
          "type": "string"
        },
        "request_timeout": {
          "type": "string"
        },
        "max_requests": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "max_redirects": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "max_response_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 10485760
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "minimum_score_coverage": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "cert_expiry_warning_days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 365
        },
        "fail_on": {
          "enum": [
            "none",
            "low",
            "medium",
            "high",
            "critical"
          ]
        }
      }
    },
    "email": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dkim_selectors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "providers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "geoip": {
          "type": "string"
        },
        "asn": {
          "type": "string"
        },
        "rdap": {
          "enum": [
            "enabled",
            "disabled"
          ]
        }
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "format": {
          "enum": [
            "terminal",
            "json",
            "sarif"
          ]
        },
        "redact_sensitive": {
          "type": "boolean"
        }
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "acknowledged": {
          "type": "boolean"
        }
      }
    },
    "active": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowed_ports": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          }
        },
        "max_hosts": {
          "type": "integer",
          "minimum": 1
        },
        "max_connections": {
          "type": "integer",
          "minimum": 1
        },
        "max_packets_per_second": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "profile": {
            "const": "active"
          }
        },
        "required": [
          "profile"
        ]
      },
      "then": {
        "required": [
          "active",
          "authorization"
        ]
      }
    }
  ]
}
